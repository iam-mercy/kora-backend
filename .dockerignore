# Build artifacts — never send the local target dir into the build context.
target/

# Version-control metadata. build.rs degrades GIT_SHA to "unknown" without it.
.git/
.gitignore
.gitattributes

# Local secrets / env overrides — the image must never bake these in.
.env
*.pem
*.key

# CI config and editor cruft — irrelevant to the compile.
.github/
.vscode/
.idea/
**/*.rs.bk
*.log

# Prose and container plumbing — not inputs to `cargo build`.
docs/
*.md
Dockerfile
.dockerignore
docker-compose.yml
