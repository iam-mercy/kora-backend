# Copy to .env for local development:  cp .env.example .env
#
# Vars marked "[ASSUMPTIONS.md #N]" are NOT in docs/environment-variables.md.
# They are Phase 1 additions, each justified in ASSUMPTIONS.md, to be
# reconciled with the authoritative env-var doc once real auth infra is
# decided.

# ── Database (docs/environment-variables.md) ────────────────────────────────
# Matches docker-compose.yml.
DATABASE_URL=postgresql://kora:kora@localhost:5432/kora_2fa
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_POOL_ACQUIRE_TIMEOUT_SECS=30
POOL_STATS_ENABLED=0

# ── Observability (docs/environment-variables.md) ───────────────────────────
RUST_LOG=info,kora_2fa=debug

# ── HTTP bind [ASSUMPTIONS.md #4] ───────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080

# ── JWT verification [ASSUMPTIONS.md #1] ────────────────────────────────────
# HS256 secret for verifying incoming bearer tokens and signing /2fa/login
# session tokens. Replace with real Supabase / Kora App auth config later.
# Booting with this exact value logs a loud WARN (ASSUMPTIONS.md #19).
JWT_SECRET=dev-only-insecure-change-me

# ── Session token TTL [ASSUMPTIONS.md #11] ──────────────────────────────────
SESSION_TOKEN_TTL_SECS=900

# ── TOTP secret encryption [ASSUMPTIONS.md #3] ──────────────────────────────
# 32 bytes, base64-encoded. Used as the AES-256-GCM key that encrypts TOTP
# secrets at rest. Generate a real one with:  openssl rand -base64 32
# DO NOT use this example value outside local development — booting with it
# logs a loud WARN (ASSUMPTIONS.md #19).
TOTP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
